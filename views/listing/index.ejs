<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
    <% if (allListing.length === 0) { %>
      <p class="text-muted mb-3">
        No listing found for "<%= searchQuery %>". We will notify you when a matching listing is added.
      </p>
    <% } else { %>
      <p class="text-muted mb-3">Showing results for "<%= searchQuery %>".</p>
    <% } %>
  <% } %>

  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-3">
    <% for(let listing of allListing) { %>
      <a href="/listings/<%= listing._id %>" class="listing-links">
        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b>
              <span class="badge <%= listing.isAvailable === false ? 'bg-secondary' : 'bg-success' %> ms-2">
                <%= listing.isAvailable === false ? 'Unavailable' : 'Available' %>
              </span>
              <br>
              <% if (typeof listing.price === "number") { %>
                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
              <% } %>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</div>
